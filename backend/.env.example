# Copy this file to .env and fill in values. .env is git-ignored.

# Server
PORT=4000

# Auth — single hardcoded user
AUTH_USERNAME=admin
AUTH_PASSWORD=password

# AI provider: "openai", "gemini", or leave blank to use the deterministic fallback
AI_PROVIDER=
AI_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
